# Copy this file to .env on the machine that runs the service.
# Keep ordinary settings here; inject secrets through ignored 1Password reference files.
# Leave secret fields blank. Do not commit .env or paste values into chat.

# Hevy Pro key from https://hevy.com/settings?developer; store in 1Password.
HEVY_API_KEY=

# Password for the phone page. At least 10 characters.
APP_PASSWORD=

# Signs the login cookie. Generate and store it locally in 1Password.
# At least 16 characters.
APP_SECRET=

# Exact Authorization header value for a future Hevy saved-workout callback.
# Leave this blank. Use a different value from HEVY_API_KEY.
# Do not register a webhook URL until a private authenticated route is ready.
HEVY_WEBHOOK_AUTHORIZATION=

# Cloud model for the Ask the coach button. Supply its key through 1Password.
# Leave this blank here. A question can use multiple paid model/tool steps.
# This service does not download a model, and Cursor is not this key.
OPENAI_API_KEY=

# Optional. Empty uses gpt-5.6-luna.
OPENAI_MODEL=

HEVY_BASE_URL=https://api.hevyapp.com

# MongoDB is primary. This URI is for the Mac app with docker-compose.local.yml.
# Compose replaces it with mongodb://mongodb:27017 for coach.
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=amoregymbro
MONGODB_AUTH_SOURCE=admin

# Dedicated app user, authenticated against admin with readWrite on the app DB.
# Set a unique password locally; do not reuse the bootstrap admin password.
MONGODB_USERNAME=amoregymbro_app
MONGODB_PASSWORD=

# Bootstrap admin, separate from the app user. Set a different strong password.
# Users are created only on an empty volume. Keep existing-volume credentials.
MONGO_INITDB_ROOT_USERNAME=amore_admin
MONGO_INITDB_ROOT_PASSWORD=

# Retain the old SQLite path for migration and explicit rollback (backend=sqlite).
DATABASE_PATH=./data/fitness.db
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=21600
HEVY_PAGE_DELAY_SECONDS=0.25
SECURE_COOKIES=false

# Used by Docker Compose when you deploy later. 127.0.0.1 keeps the
# published port on the machine itself. Do not forward this port from your router.
BIND_HOST=127.0.0.1
APP_PORT=8787

# Optional Garmin Personal API, supplied through 1Password runtime references.
GARMIN_API_KEY=
GARMIN_SYNC_ENABLED=false
GARMIN_SYNC_INTERVAL_SECONDS=21600
