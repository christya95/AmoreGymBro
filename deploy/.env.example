# NAS database-only deployment. Create .env on the NAS; never copy the Mac .env.
# Set both passwords locally before startup. Do not share or commit .env.

# Bootstrap administrator: separate username and password from the app account.
MONGO_INITDB_ROOT_USERNAME=amore_nas_admin
MONGO_INITDB_ROOT_PASSWORD=

# Dedicated app/Compass account; authenticated against admin, with readWrite
# only on MONGODB_DATABASE. Keep the database name for the documented transfer.
MONGODB_DATABASE=amoregymbro
MONGODB_USERNAME=amoregymbro_app
MONGODB_PASSWORD=

# The init script creates users only on an empty volume. Editing these values
# does not rotate existing users. Never remove a data volume to fix credentials.
# The coach is not deployed here; its connection configuration is a later step.
